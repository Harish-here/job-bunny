# Secrets — must be ignored before init.js ever writes a token
.env

# Personal data — public repo ships sanitized templates (templates/, resume.example.json) instead
# resume.json: real contact details + work history (build-time source of truth)
# data/cache.json: live job pipeline (ratings, salary-band search URLs, Notion IDs)
resume.json
data/cache.json

# Profiles — all profile config/data is local-only; templates/ ships the seeds
profiles/*
config.json

# Dependencies
node_modules/

# Per-run intermediate artifacts (regenerated each run)
jobs_raw_text.json
jobs_raw_decisions.json
jobs_raw_decisions.md
jobs_raw_checkpoint.json
jobs_raw_checkpoint.md
jobs_raw.json
filtered_jobs.json
new_jobs.json
structure_input.md
structure_passthrough.json

# OS / editor noise
.DS_Store

# Chrome remote-debug profile (local only)
.chrome-debug/

# Pipeline orchestration lock (local only)
.jobbunny-run.lock

# Daemon supervision state (local only) — the tick loop rewrites the pidfile
# (via its .tmp sibling) every 30s, so an untracked pair here would make
# `jobbunny release`'s clean-tree check fail whenever the daemon is running.
.jobbunny-daemon.pid
.jobbunny-daemon.pid.tmp

# profiles/rajni/ is a committed, synthetic fixture profile for live-testing the
# deterministic pipeline stages + onboarding reference (see profiles/rajni/README.md).
# Must come after every blanket rule above that would otherwise re-shadow these paths
# (gitignore is last-match-wins per path) — do not move these earlier in the file.
!profiles/rajni/
!profiles/rajni/resume.json
!profiles/rajni/data/jobs_raw.json

# P3 runner: per-run observability artifacts (checkpoints, result.json,
# heartbeat, logs) are regenerated every run — never committed, even for
# the rajni fixture.
profiles/rajni/data/runs/

# P5 company registry: companies.json + companies_seen.json are generated
# per run (probe/fetch state, farm-stage side-write) — never committed.
profiles/rajni/data/registry/

# v2: every per-run stage writes its own subdirectory under profiles/<name>/data/
# (cache/, lanes/, structure/, and more to come). Ignore the whole subtree so new
# v2 stages never need a new rule here, then carve the two tracked fixture files
# back out (gitignore is last-match-wins per path — this must stay last).
profiles/*/data/*
!profiles/rajni/data/jobs_raw.json
!profiles/rajni/data/cache.json

# Board UI build output — rebuilt any time with `npm run ui:build`
ui/dist/

# Superpowers workflow state (local only)
.superpowers/
