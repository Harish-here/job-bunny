# Copy to .env (gitignored) and fill.
# Notion internal integration token (https://www.notion.so/my-integrations) — shared by all profiles
NOTION_TOKEN=
# Telegram bot token (from @BotFather) — shared across profiles; per-profile chat_id
# lives in profiles/<name>/profile.json (settings.telegram.chatId), added by hand —
# see README "Telegram digest" for the full manual procedure.
TELEGRAM_BOT_TOKEN=
# NOTE: per-profile Notion IDs live in profiles/<name>/profile.json, written during
# /setup (or by hand) — they are never read from this file.
